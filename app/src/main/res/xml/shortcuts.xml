<?xml version="1.0" encoding="utf-8"?>
<!-- Declares this app as a "Direct Share" target: tapping the OS share sheet's arrow next to the
     app icon (or a recent-person shortcut published via ContactShortcuts) redelivers the sharing
     intent straight to MainActivity, with EXTRA_SHORTCUT_ID set for a specific-person target. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="com.coursework.unifiedmail.MainActivity">
        <data android:mimeType="*/*" />
        <category android:name="com.coursework.unifiedmail.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
